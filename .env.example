# --- PostgreSQL ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_PORT_OUT=5447
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_DB=club-ai

# --- JWT auth ---
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_SECRET=change_me_access
JWT_ACCESS_EXPIRES=365d
JWT_REFRESH_EXPIRES=365d

# --- Telegram bot / admin ---
# Bot token from @BotFather
TELEGRAM_TOKEN=
# Launch bot polling on backend startup (true/false)
TELEGRAM_BOT_LAUNCH=true
# Telegram chat id for technical logs/alerts
TELEGRAM_ADMINCHAT_ID=
# Comma-separated Telegram user ids with admin role (example: 123,456)
TELEGRAM_ADMIN_IDS=

# --- YooKassa payments ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- S3 storage ---
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public endpoint, for example: https://s3.firstvds.ru
S3_URL=
# Bucket name used by FileService uploads
S3_BUCKET=content-zavod-test

# --- OpenAI / AI chat ---
# OpenAI API key for GPT and Sora chat endpoints
OPENAI_API_KEY=
# Default GPT model for /api/chat/gpt
GPT_CHAT_MODEL=gpt-4o-mini
# Default max completion tokens for GPT response
GPT_CHAT_MAX_COMPLETION_TOKENS=800
# Default Sora model for /api/chat/sora when model is omitted
SORA_CHAT_MODEL=sora-2
# Background polling interval for Sora run status updates
SORA_POLL_INTERVAL_MS=15000
# Max allowed Sora run lifetime before timeout error
SORA_TIMEOUT_MS=900000
# Max number of Sora runs polled in parallel per interval
SORA_PARALLEL_POLL_LIMIT=5

# --- App URL ---
FRONTEND_URL=http://localhost:3000

# --- Automation retry/timeout behavior ---
# Enable auto-retry for failed automation runs (true/false)
AUTOMATION_RETRY_ENABLED=true
# Delay before retry attempt
AUTOMATION_RETRY_DELAY_MS=30000
# Cooldown per automation between retries
AUTOMATION_RETRY_COOLDOWN_MS=300000
# Pending run timeout before forced error
AUTOMATION_PENDING_TIMEOUT_MS=900000
# Interval for checking stale pending runs
AUTOMATION_PENDING_CHECK_INTERVAL_MS=60000

# --- Runtime ---
# Project env convention (dev/production)
ENV=dev
# Node.js env mode (development/production/test)
NODE_ENV=development
